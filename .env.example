MONGODB_URI_SERVER=
TOKEN_SECRET=
# AI Recruitment (parse CV, so khớp JD)
ANTHROPIC_API_KEY=
# Tuỳ chọn, mặc định claude-sonnet-5-5
ANTHROPIC_MODEL=

# Gửi email (Email Template). Với Gmail dùng "mật khẩu ứng dụng"
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Giới hạn CORS: danh sách domain frontend, cách nhau bởi dấu phẩy. Để trống = cho phép mọi origin (chỉ nên dùng khi phát triển)
CORS_ORIGINS=

# Đồng bộ Google Sheet (Service Account). Dán toàn bộ nội dung file JSON (hoặc mã base64 của nó)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Tắt bộ lập lịch tự động: SHEET_SYNC_SCHEDULER=off

# Nhận CV từ email (IMAP). Khóa 32 byte để mã hóa mật khẩu hộp thư lưu trong DB:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAIL_CRED_KEY=
# Tắt bộ lập lịch nhận CV: MAIL_INGEST_SCHEDULER=off
